  "narrative": {
    "northStar": "A Lua em Três Tintas",
    "overview": "Tsuki quer dizer lua em japonês. A página é uma estampa em papel branco com tinta sumi: a lua aparece preta no papel, branca no escuro e vermelha onde o cursor passa. O símbolo é a cruz de Malta de braços côncavos; a mascote é um leão heráldico rampante, vermelho com garras e língua brancas. O vermelho é o selo; azul e verde são a segunda e a terceira cor de selo.",
    "keyCharacteristics": [
      "Papel washi, tinta sumi e vermelho de selo.",
      "Cantos retos, com um corte diagonal como forma da marca.",
      "Estampas japonesas de domínio público em placas com recorte em degraus.",
      "Pilha de seções que se cobrem, com contornos que rolam ao fundo.",
      "Lua de hoje calculada no navegador."
    ],
    "rules": [
      {
        "name": "The Seal Rule",
        "body": "O vermelho é um selo, não um fundo de página: marcas, botões, a lua revelada e a borda do rodapé.",
        "section": "colors"
      },
      {
        "name": "The Three Moons Rule",
        "body": "Preta no papel claro (branca no escuro), vermelha sob o cursor, branca nos painéis escuros.",
        "section": "colors"
      }
    ],
    "dos": [
      "Usar o vermelho em marcas pequenas e na lua revelada.",
      "Medir em rem ou cqw e manter texto corrido em 16px ou mais.",
      "Dar crédito às estampas no rodapé e em assets/credits.json."
    ],
    "donts": [
      "Não usar sombras, vidro ou degradês em elementos de interface.",
      "Não pôr texto sobre uma estampa sem fundo sólido.",
      "Não inventar fatos de marca; o que for provisório fica marcado."
    ]
  }
