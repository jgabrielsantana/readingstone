  "components": [
    {
      "name": "Botão Azul",
      "kind": "button",
      "refersTo": "button-blue",
      "description": "Ação primária em pílula com selo circular; hover escurece para blue-deep.",
      "html": "<span class=\"ds-pill\"><span class=\"ds-pill-in\">Assinar grátis<span class=\"ds-badge\">&rarr;</span></span></span>",
      "css": ".ds-pill{display:inline-block;transition:transform 240ms cubic-bezier(0.23,1,0.32,1)}.ds-pill:hover{transform:scale(1.03)}.ds-pill:active{transform:scale(0.97)}.ds-pill-in{display:inline-flex;align-items:center;gap:0.75rem;border-radius:9999px;background:var(--blue,#1c3a6b);color:#f4f6fa;font:500 1rem Onest,system-ui,sans-serif;padding:0.375rem 0.375rem 0.375rem 1.5rem;transition:background-color 200ms ease}.ds-pill:hover .ds-pill-in{background:#14264a}.ds-badge{display:grid;place-items:center;width:2.25rem;height:2.25rem;border-radius:9999px;background:#f4f6fa;color:#1c3a6b;transition:transform 240ms cubic-bezier(0.23,1,0.32,1)}.ds-pill:hover .ds-badge{transform:translate(0.125rem,-0.125rem)}.ds-pill:focus-visible{outline:0.1875rem solid #1c3a6b;outline-offset:0.1875rem}"
    },
    {
      "name": "Botão Escuro",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Pílula noite com selo branco, para ações de contraste sobre papel.",
      "html": "<span class=\"ds-dark\"><span class=\"ds-dark-in\">Ver edições<span class=\"ds-dark-badge\">&rarr;</span></span></span>",
      "css": ".ds-dark{display:inline-block;transition:transform 240ms cubic-bezier(0.23,1,0.32,1)}.ds-dark:hover{transform:scale(1.03)}.ds-dark:active{transform:scale(0.97)}.ds-dark-in{display:inline-flex;align-items:center;gap:0.75rem;border-radius:9999px;background:#22201d;color:#fff;font:500 1rem Onest,system-ui,sans-serif;padding:0.375rem 0.375rem 0.375rem 1.5rem}.ds-dark-badge{display:grid;place-items:center;width:2.25rem;height:2.25rem;border-radius:9999px;background:#fff;color:#22201d}"
    },
    {
      "name": "Botão Claro",
      "kind": "button",
      "refersTo": "button-light",
      "description": "Pílula em papel degrau 1 com selo noite; hover sobe ao degrau 2.",
      "html": "<span class=\"ds-light\"><span class=\"ds-light-in\">Saiba mais<span class=\"ds-light-badge\">&rarr;</span></span></span>",
      "css": ".ds-light{display:inline-block;transition:transform 240ms cubic-bezier(0.23,1,0.32,1)}.ds-light:hover{transform:scale(1.03)}.ds-light-in{display:inline-flex;align-items:center;gap:0.75rem;border-radius:9999px;background:#e8ecf3;color:#22201d;font:500 1rem Onest,system-ui,sans-serif;padding:0.375rem 0.375rem 0.375rem 1.5rem;transition:background-color 200ms ease}.ds-light:hover .ds-light-in{background:#dbe2ee}.ds-light-badge{display:grid;place-items:center;width:2.25rem;height:2.25rem;border-radius:9999px;background:#22201d;color:#fff}"
    },
    {
      "name": "Cartão de Edição",
      "kind": "card",
      "refersTo": "card-blue",
      "description": "Cartão azul de raio 2rem com selo, plate em luminosity, título e chips.",
      "html": "<a class=\"ds-card\" href=\"#\"><div class=\"ds-card-meta\"><span>12 jun 2026</span><span class=\"ds-card-badge\">&nearr;</span></div><div class=\"ds-card-plate\"></div><div class=\"ds-card-bot\"><div class=\"ds-card-t\">Como conferir uma citação gerada por IA</div><p class=\"ds-card-d\">Três passos para rastrear a fonte antes de repetir a resposta.</p></div></a>",
      "css": ".ds-card{display:block;position:relative;min-height:22rem;overflow:hidden;border-radius:2rem;background:#1c3a6b;padding:1.5rem;color:#f4f6fa;font-family:Onest,system-ui,sans-serif;text-decoration:none;transition:transform 280ms cubic-bezier(0.23,1,0.32,1),background-color 200ms ease}.ds-card:hover{transform:translateY(-0.5rem) scale(1.012);background:#14264a}.ds-card-meta{display:flex;justify-content:space-between;align-items:flex-start;color:#c4d0e5}.ds-card-badge{display:grid;place-items:center;width:2.75rem;height:2.75rem;border-radius:9999px;background:rgba(244,246,250,0.14);color:#f4f6fa;transition:transform 280ms cubic-bezier(0.23,1,0.32,1)}.ds-card:hover .ds-card-badge{transform:rotate(45deg) scale(1.08)}.ds-card-plate{position:absolute;inset:4.75rem 1.5rem auto;height:7.5rem;border-radius:0.9375rem;background:#14264a}.ds-card-bot{position:absolute;inset-inline:1.5rem;bottom:1.5rem}.ds-card-t{font-size:1.25rem;font-weight:500;letter-spacing:-0.01em;line-height:1.15}.ds-card-d{margin-top:0.5rem;color:#c4d0e5}.ds-card:focus-visible{outline:0.1875rem solid #f4f6fa;outline-offset:0.1875rem}"
    },
    {
      "name": "Linha de Cobertura",
      "kind": "custom",
      "refersTo": "row",
      "description": "Linha de raio 1.25rem em papel degrau 1; em hover vira azul, recua e desliza o selo.",
      "html": "<a class=\"ds-row\" href=\"#\"><span class=\"ds-row-in\"><span class=\"ds-row-t\">Como ler uma resposta de IA</span><span class=\"ds-row-badge\">&rarr;</span></span></a>",
      "css": ".ds-row{display:block;font-family:Onest,system-ui,sans-serif;text-decoration:none;color:#22201d}.ds-row-in{display:flex;align-items:center;gap:1rem;border-radius:1.25rem;background:#e8ecf3;padding:1.5rem;transition:background-color 200ms ease,padding 240ms cubic-bezier(0.23,1,0.32,1),color 200ms ease}.ds-row-t{flex:1;font-size:1.5rem;font-weight:500;letter-spacing:-0.01em}.ds-row-badge{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:9999px;background:#1c3a6b;color:#f4f6fa;transition:transform 240ms cubic-bezier(0.23,1,0.32,1)}.ds-row:hover .ds-row-in{background:#1c3a6b;color:#f4f6fa;padding-left:2rem;padding-right:1.25rem}.ds-row:hover .ds-row-badge{transform:translateX(0.3125rem);background:#f4f6fa;color:#1c3a6b}.ds-row:focus-visible{outline:0.1875rem solid #1c3a6b;outline-offset:0.1875rem}"
    },
    {
      "name": "Aba de Filtro",
      "kind": "chip",
      "refersTo": "tab",
      "description": "Aba de raio 0.9375rem em papel degrau 1; selecionada em azul.",
      "html": "<button class=\"ds-tab\" aria-pressed=\"false\">Todas</button> <button class=\"ds-tab\" aria-pressed=\"true\">Guias</button>",
      "css": ".ds-tab{background:#e8ecf3;color:#22201d;border:0;border-radius:0.9375rem;min-height:3rem;padding:0.5rem 1rem;font:500 1rem Onest,system-ui,sans-serif;text-align:left;cursor:pointer;transition:background-color 150ms ease,color 150ms ease,transform 160ms cubic-bezier(0.23,1,0.32,1)}.ds-tab:active{transform:scale(0.97)}.ds-tab[aria-pressed=true]{background:#1c3a6b;color:#f4f6fa}.ds-tab:not([aria-pressed=true]):hover{background:#dbe2ee}.ds-tab:focus-visible{outline:0.1875rem solid #1c3a6b;outline-offset:0.1875rem}"
    },
    {
      "name": "Campo de E-mail",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Campo do modal de assinatura: papel degrau 1, raio 0.9375rem, foco no degrau 2 com contorno azul.",
      "html": "<label class=\"ds-label\">E-mail<input class=\"ds-input\" type=\"email\" placeholder=\"voce@exemplo.com\"></label>",
      "css": ".ds-label{display:grid;gap:0.375rem;font:500 1rem Onest,system-ui,sans-serif;color:#3f4655}.ds-input{width:100%;border:0;border-radius:0.9375rem;background:#e8ecf3;padding:0.9375rem 1rem;font:400 1rem Onest,system-ui,sans-serif;color:#22201d;outline:none;transition:background-color 200ms ease}.ds-input:focus{background:#dbe2ee;outline:0.125rem solid #1c3a6b;outline-offset:0.125rem}"
    },
    {
      "name": "Cartão do Hero",
      "kind": "custom",
      "refersTo": "hero-card",
      "description": "Carrossel das edições mais novas: ladrilho noite, painel de texto, pontos e botões circulares.",
      "html": "<div class=\"ds-hcard\"><div class=\"ds-hcard-tile\"><svg width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"7\"/></svg></div><div class=\"ds-hcard-panel\"><div><div class=\"ds-hcard-cap\">Edição recente</div><div class=\"ds-hcard-title\">Como conferir uma citação gerada por IA</div></div><div class=\"ds-hcard-foot\"><span class=\"ds-dots\"><i class=\"ds-dot on\"></i><i class=\"ds-dot\"></i><i class=\"ds-dot\"></i></span></div></div></div>",
      "css": ".ds-hcard{display:flex;gap:0.5rem;width:21rem;border-radius:1.25rem;background:rgba(244,246,250,0.94);color:#22201d;padding:0.5rem;font-family:Onest,system-ui,sans-serif}.ds-hcard-tile{aspect-ratio:1;width:6rem;display:grid;place-items:center;border-radius:0.9375rem;background:#22201d;color:#e58a6e;font-size:2rem}.ds-hcard-panel{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between;gap:0.5rem;border-radius:0.9375rem;background:#e8ecf3;padding:0.75rem}.ds-hcard-cap{font-size:0.9375rem;font-weight:500;color:#3f4655}.ds-hcard-title{font-size:1rem;font-weight:500;line-height:1.3}.ds-dots{display:flex;gap:0.25rem;align-items:center}.ds-dot{display:block;height:0.25rem;width:0.375rem;border-radius:9999px;background:rgba(34,32,29,0.25)}.ds-dot.on{width:1rem;background:#1c3a6b}"
    },
    {
      "name": "Pedra de Leitura",
      "kind": "custom",
      "refersTo": "card-blue",
      "description": "Componente assinatura: parágrafo de exemplo com camada azul revelada por círculo (versão estática mostrada aqui).",
      "html": "<div class=\"ds-stone\"><p>A pesquisa citada foi publicada em <span class=\"ds-flag\">2019 pela universidade de Lisboa</span>, segundo o modelo.</p></div>",
      "css": ".ds-stone{padding:0.9375rem 1.125rem;border-radius:1.25rem;background:#1c3a6b;color:#f4f6fa;font-family:Onest,system-ui,sans-serif}.ds-stone p{font-size:1.375rem;line-height:1.32;letter-spacing:-0.01em;font-weight:500;max-width:24em}.ds-flag{text-decoration:underline;text-decoration-color:#e58a6e;text-decoration-thickness:0.25rem;text-underline-offset:0.375rem;text-decoration-skip-ink:none}"
    },
    {
      "name": "Barra de Abas",
      "kind": "nav",
      "refersTo": "tabbar-item",
      "description": "Barra inferior noite de largura total; aba atual em pílula papel. A fileira sob o cabeçalho usa as mesmas pílulas em on-blue a 16%.",
      "html": "<nav class=\"ds-tabbar\"><a href=\"#\" aria-current=\"page\">Início</a><a href=\"#\">O livro</a><a href=\"#\">Founders</a><a href=\"#\">FAQ</a></nav>",
      "css": ".ds-tabbar{display:flex;justify-content:center;gap:0.25rem;padding:0.5rem 0.75rem;background:#22201d;font-family:Onest,system-ui,sans-serif}.ds-tabbar a{display:grid;place-items:center;min-height:2.75rem;padding:0 1.25rem;border-radius:9999px;color:#b9bcc6;font-size:1rem;font-weight:500;text-decoration:none;white-space:nowrap;transition:background-color 200ms ease,color 200ms ease,transform 160ms cubic-bezier(0.23,1,0.32,1)}.ds-tabbar a:active{transform:scale(0.97)}.ds-tabbar a[aria-current=page]{background:#f4f6fa;color:#22201d}.ds-tabbar a:not([aria-current]):hover{color:#fff;background:rgba(255,255,255,0.12)}.ds-tabbar a:focus-visible{outline:0.1875rem solid #f4f6fa;outline-offset:0.1875rem}"
    },
    {
      "name": "Pergunta da FAQ",
      "kind": "custom",
      "refersTo": "faq-item",
      "description": "Linha de raio 1.25rem com botão de largura total e selo azul de mais que gira 45 graus ao abrir; resposta expande por grid-rows.",
      "html": "<ul class=\"ds-q-list\"><li class=\"ds-q open\"><button class=\"ds-q-btn\" aria-expanded=\"true\"><span>O que é a ReadingStone?</span><span class=\"ds-q-i\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></span></button><div class=\"ds-q-a\"><div><p>Uma publicação que ensina a ler a IA de perto.</p></div></div></li><li class=\"ds-q\"><button class=\"ds-q-btn\" aria-expanded=\"false\"><span>Quanto custa?</span><span class=\"ds-q-i\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></span></button><div class=\"ds-q-a\"><div><p>Resposta de exemplo.</p></div></div></li></ul>",
      "css": ".ds-q-list{list-style:none;margin:0;padding:0;display:grid;gap:0.5rem;width:30rem;font-family:Onest,system-ui,sans-serif;color:#22201d}.ds-q{border-radius:1.25rem;background:#e8ecf3}.ds-q:nth-child(even){background:#dbe2ee}.ds-q-btn{display:flex;align-items:center;justify-content:space-between;gap:1rem;width:100%;min-height:4.5rem;padding:1rem 1.25rem;border:0;border-radius:1.25rem;background:none;color:inherit;text-align:left;font:600 1.1875rem/1.25 Onest,system-ui,sans-serif;letter-spacing:-0.01em;cursor:pointer}.ds-q-i{display:grid;place-items:center;flex:none;width:2.5rem;height:2.5rem;border-radius:9999px;background:#1c3a6b;color:#f4f6fa;transition:transform 300ms cubic-bezier(0.23,1,0.32,1),background-color 200ms ease}.ds-q-btn:hover .ds-q-i{background:#14264a}.ds-q.open .ds-q-i{transform:rotate(45deg)}.ds-q-a{display:grid;grid-template-rows:0fr;transition:grid-template-rows 300ms cubic-bezier(0.23,1,0.32,1)}.ds-q-a>div{overflow:hidden}.ds-q-a p{margin:0;padding:0 1.25rem 1.5rem;max-width:60ch;opacity:0;transform:translateY(0.375rem);transition:opacity 250ms ease,transform 300ms cubic-bezier(0.23,1,0.32,1)}.ds-q.open .ds-q-a{grid-template-rows:1fr}.ds-q.open .ds-q-a p{opacity:1;transform:none}.ds-q-btn:focus-visible{outline:0.1875rem solid #1c3a6b;outline-offset:-0.1875rem}"
